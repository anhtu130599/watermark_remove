# === Server & Network ===
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:8000"]

# === Hardware & Memory (Tối ưu cho Intel Core Ultra / 16 GB RAM) ===
EXECUTION_BACKEND=auto
QUANTIZATION_POLICY=fp16
LOW_MEM_MODE=true
RAM_BUDGET_GB=16
AUTO_UNLOAD_SECONDS=180
MAX_CONCURRENT_JOBS=1

# === Media & AI Models ===
MAX_INPUT_SIZE_MB=20
MAX_RESOLUTION_PX=4096
DEFAULT_DILATION_PX=5
DEFAULT_DETECT_PROMPT=watermark, logo, text, stamp, caption
FLORENCE_MODEL_ID=microsoft/Florence-2-base
FLORENCE_REVISION=main
